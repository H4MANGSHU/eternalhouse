# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:pass@localhost:5432/eternalhouse
DB_POOL_MAX=8
DB_ACQUIRE_TIMEOUT_MS=5000
VALKEY_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3000
SESSION_SECRET="asbsbsbsbssb"
DEV_LOGIN=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cashfree (test keys → sandbox)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Transactional mail: auto uses SMTP first; use brevo to force the Brevo API.
MAIL_PROVIDER=auto
BREVO_API_KEY=your_brevo_api_key
SMTP_PORT=587
SMTP_USER=smtp-relay.brevo.com
#SMTP_PASS=your_brevo_smtp_key
# Brevo SMTP (login looks like xxxxxx001@smtp-brevo.com; password is the xsmtpsib- key)
SMTP_HOST=smtp-relay.brevo.com
MAIL_FROM=EternalHouse <you@yourdomain.com>
