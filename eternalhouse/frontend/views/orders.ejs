<%- include('partials/head', {nav: ''}) %>
<div class="wrap">
  <div class="page-h"><p class="eyebrow">Account</p><h1>Your orders</h1></div>
  <% if (!orders.length) { %><div class="empty"><h2>No orders yet</h2><p><a class="btn" href="/shop">Start shopping</a></p></div>
  <% } else { %><div class="pb-l ovx pt-m"><table class="tbl"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody>
    <% orders.forEach(function(o){ %><tr><td><a class="link" href="/orders/<%= o.order_no %>"><%= o.order_no %></a></td><td><%= new Date(o.created_at).toLocaleDateString('en-IN') %></td><td><span class="badge <%= o.status %>"><%= o.status.replace('_',' ') %></span></td><td><%= inr(o.total) %></td></tr><% }) %>
  </tbody></table></div><% } %>
</div>
<%- include('partials/foot') %>
