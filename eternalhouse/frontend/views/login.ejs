<%- include('partials/head', {nav: ''}) %>
<div class="wrap"><div class="auth" data-reveal="scale">
  <p class="eyebrow">Members</p>
  <h1><%= mode === 'signup' ? 'Create your account' : 'Welcome back' %></h1>
  <p class="muted"><%= mode === 'signup' ? 'Create an account to save your bag and check out.' : 'Sign in to save your bag and check out.' %></p>
  <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
  <form method="post" action="<%= mode === 'signup' ? '/auth/signup' : '/auth/login' %>" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <% if (mode === 'signup') { %>
    <label>Name<input class="field" name="name" type="text" autocomplete="name" maxlength="80" required></label>
    <% } %>
    <label>Email<input class="field" name="email" type="email" autocomplete="email" maxlength="254" required></label>
    <label>Password<input class="field" name="password" type="password" autocomplete="<%= mode === 'signup' ? 'new-password' : 'current-password' %>" maxlength="128"<% if (mode === 'signup') { %> minlength="12"<% } %> required></label>
    <button class="btn" type="submit"><%= mode === 'signup' ? 'Create account' : 'Sign in' %></button>
  </form>
  <p class="muted fs12 auth-switch">
    <% if (mode === 'signup') { %>Already have an account? <a href="/login?next=<%= encodeURIComponent(next) %>">Sign in</a>
    <% } else { %>New here? <a href="/login?mode=signup&amp;next=<%= encodeURIComponent(next) %>">Create an account</a><% } %>
  </p>
  <p class="eyebrow auth-or">or</p>
  <a class="gbtn" href="/auth/google?next=<%= encodeURIComponent(next) %>" data-magnetic>
    <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.6 5.9c4.5-4.1 7-10.2 7-17.6z"/><path fill="#FBBC05" d="M10.5 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
    Continue with Google</a>
  <% if (!cfg.isProd) { %>
  <div class="dev"><p class="eyebrow">Developer notes</p>
    <p class="muted fs12">Register this exact redirect URI in Google Cloud Console → Credentials → your OAuth client:</p><code><%= cfg.redirectUri %></code>
    <p class="muted fs12">Always open the site at the same origin (localhost ≠ 127.0.0.1).</p>
    <% if (cfg.devLogin) { %>
    <form method="post" action="/auth/dev" class="devform"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
      <input class="field" name="email" type="email" value="dev@eternalhouse.local" aria-label="Dev email"><button class="btn ghost" type="submit">Dev sign-in (no Google)</button></form>
    <% } %>
  </div><% } %>
</div></div>
<%- include('partials/foot') %>
